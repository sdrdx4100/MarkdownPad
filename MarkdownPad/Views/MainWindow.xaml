<Window x:Class="MarkdownPad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MarkdownPad.Controls"
        xmlns:vm="clr-namespace:MarkdownPad.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Height="700"
        Width="1200"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="MenuCommandItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="CommandParameter" Value="{Binding Parameter}" />
        </Style>
    </Window.Resources>

    <!--
        Only application-level shortcuts live here. Clipboard, undo and select-all
        are left to the editor's own ApplicationCommands: a KeyBinding on the
        window never won that race, which is why Ctrl+V used to bypass the
        image-paste handling entirely.
    -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FindCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ReplaceCommand}" />
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding BoldCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ItalicCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding InsertLinkCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F5F5F5">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="開く(_O)..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="最近使ったファイル(_R)" ItemsSource="{Binding RecentFiles}"
                          ItemContainerStyle="{StaticResource MenuCommandItemStyle}" />
                <Separator />
                <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="HTMLとしてエクスポート(_H)..." Command="{Binding ExportHtmlCommand}" />
                <MenuItem Header="PDFとしてエクスポート(_P)..." Command="{Binding ExportPdfCommand}" />
                <MenuItem Header="印刷(_R)..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="終了(_X)" Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" Command="Undo" CommandTarget="{Binding ElementName=EditorTextBox}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="やり直し(_R)" Command="Redo" CommandTarget="{Binding ElementName=EditorTextBox}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="切り取り(_T)" Command="Cut" CommandTarget="{Binding ElementName=EditorTextBox}" InputGestureText="Ctrl+X" />
                <MenuItem Header="コピー(_C)" Command="Copy" CommandTarget="{Binding ElementName=EditorTextBox}" InputGestureText="Ctrl+C" />
                <MenuItem Header="貼り付け(_P)" Command="Paste" CommandTarget="{Binding ElementName=EditorTextBox}" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="すべて選択(_A)" Command="SelectAll" CommandTarget="{Binding ElementName=EditorTextBox}" InputGestureText="Ctrl+A" />
                <Separator />
                <MenuItem Header="検索(_F)..." Command="{Binding FindCommand}" InputGestureText="Ctrl+F" />
                <MenuItem Header="置換(_H)..." Command="{Binding ReplaceCommand}" InputGestureText="Ctrl+H" />
                <MenuItem Header="次を検索(_N)" Command="{Binding FindNextCommand}" InputGestureText="F3" />
                <MenuItem Header="前を検索(_V)" Command="{Binding FindPreviousCommand}" InputGestureText="Shift+F3" />
                <Separator />
                <MenuItem Header="行を複製(_D)" Command="{Binding DuplicateLineCommand}" InputGestureText="Ctrl+D" />
                <MenuItem Header="行を削除(_L)" Command="{Binding DeleteLineCommand}" InputGestureText="Ctrl+Shift+K" />
                <MenuItem Header="行を上へ移動" Command="{Binding MoveLineUpCommand}" InputGestureText="Alt+↑" />
                <MenuItem Header="行を下へ移動" Command="{Binding MoveLineDownCommand}" InputGestureText="Alt+↓" />
            </MenuItem>

            <MenuItem Header="表示(_V)">
                <MenuItem Header="プレビューを表示(_P)" IsCheckable="True" IsChecked="{Binding IsPreviewVisible}" />
                <MenuItem Header="行番号を表示(_L)" IsCheckable="True" IsChecked="{Binding ShowLineNumbers}" />
                <MenuItem Header="ワードラップ(_W)" IsCheckable="True" IsChecked="{Binding WordWrap}" />
                <MenuItem Header="スクロールを同期(_S)" IsCheckable="True" IsChecked="{Binding SyncScroll}" />
                <Separator />
                <MenuItem Header="プレビューのテーマ(_T)">
                    <MenuItem Header="ライト" IsCheckable="True" IsChecked="{Binding IsLightTheme}" />
                    <MenuItem Header="ダーク" IsCheckable="True" IsChecked="{Binding IsDarkTheme}" />
                    <MenuItem Header="システム設定に従う" IsCheckable="True" IsChecked="{Binding IsSystemTheme}" />
                </MenuItem>
                <MenuItem Header="MarkdownにHTMLを許可(_H)" IsCheckable="True" IsChecked="{Binding AllowRawHtml}"
                          ToolTip="オフにすると、文書内の生HTMLをそのまま表示せずエスケープします。" />
                <Separator />
                <MenuItem Header="拡大(_I)" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="縮小(_O)" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="標準のサイズ(_R)" Command="{Binding ZoomResetCommand}" InputGestureText="Ctrl+0" />
            </MenuItem>

            <MenuItem Header="挿入(_I)">
                <MenuItem Header="画像を挿入(_I)..." Command="{Binding InsertImageCommand}" />
                <MenuItem Header="取り込んだ画像を文書フォルダーにコピー(_C)" IsCheckable="True"
                          IsChecked="{Binding CopyImportedImages}"
                          ToolTip="オフにすると、ドラッグ＆ドロップした画像は元の場所を参照します。" />
                <MenuItem Header="リンクを挿入(_L)..." Command="{Binding InsertLinkCommand}" InputGestureText="Ctrl+K" />
                <MenuItem Header="テーブル(_T)" Command="{Binding InsertTableCommand}" />
                <MenuItem Header="水平線(_R)" Command="{Binding InsertHorizontalRuleCommand}" />
                <Separator />
                <MenuItem Header="見出し1" Command="{Binding HeadingCommand}" CommandParameter="1" />
                <MenuItem Header="見出し2" Command="{Binding HeadingCommand}" CommandParameter="2" />
                <MenuItem Header="見出し3" Command="{Binding HeadingCommand}" CommandParameter="3" />
                <Separator />
                <MenuItem Header="太字(_B)" Command="{Binding BoldCommand}" InputGestureText="Ctrl+B" />
                <MenuItem Header="斜体(_I)" Command="{Binding ItalicCommand}" InputGestureText="Ctrl+I" />
                <MenuItem Header="取り消し線(_S)" Command="{Binding StrikethroughCommand}" />
                <MenuItem Header="インラインコード(_N)" Command="{Binding InlineCodeCommand}" />
                <MenuItem Header="コードブロック(_C)" Command="{Binding CodeBlockCommand}" />
                <Separator />
                <MenuItem Header="引用(_Q)" Command="{Binding QuoteCommand}" />
                <MenuItem Header="箇条書き(_U)" Command="{Binding BulletListCommand}" />
                <MenuItem Header="番号付きリスト(_O)" Command="{Binding OrderedListCommand}" />
                <MenuItem Header="タスクリスト(_K)" Command="{Binding TaskListCommand}" />
            </MenuItem>

            <MenuItem Header="書式(_O)">
                <MenuItem Header="文字コード(_E)" ItemsSource="{Binding EncodingOptions}"
                          ItemContainerStyle="{StaticResource MenuCommandItemStyle}" />
                <MenuItem Header="改行コード(_N)">
                    <MenuItem Header="CRLF (Windows)" Command="{Binding SetNewLineCommand}" CommandParameter="Crlf" />
                    <MenuItem Header="LF (Unix)" Command="{Binding SetNewLineCommand}" CommandParameter="Lf" />
                    <MenuItem Header="CR (Classic Mac)" Command="{Binding SetNewLineCommand}" CommandParameter="Cr" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="マークダウンガイド(_M)" Command="{Binding MarkdownGuideCommand}" />
                <MenuItem Header="バージョン情報(_A)" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="1" Background="#FAFAFA" ToolBarTray.IsLocked="True">
            <Button Command="{Binding NewCommand}" ToolTip="新規作成 (Ctrl+N)" AutomationProperties.Name="新規作成" Padding="8,4">
                <TextBlock Text="📄" FontSize="16" />
            </Button>
            <Button Command="{Binding OpenCommand}" ToolTip="開く (Ctrl+O)" AutomationProperties.Name="開く" Padding="8,4">
                <TextBlock Text="📂" FontSize="16" />
            </Button>
            <Button Command="{Binding SaveCommand}" ToolTip="保存 (Ctrl+S)" AutomationProperties.Name="保存" Padding="8,4">
                <TextBlock Text="💾" FontSize="16" />
            </Button>
            <Separator />
            <Button Command="Undo" CommandTarget="{Binding ElementName=EditorTextBox}" ToolTip="元に戻す (Ctrl+Z)"
                    AutomationProperties.Name="元に戻す" Padding="8,4">
                <TextBlock Text="↩" FontSize="16" />
            </Button>
            <Button Command="Redo" CommandTarget="{Binding ElementName=EditorTextBox}" ToolTip="やり直し (Ctrl+Y)"
                    AutomationProperties.Name="やり直し" Padding="8,4">
                <TextBlock Text="↪" FontSize="16" />
            </Button>
            <Separator />
            <Button Command="Cut" CommandTarget="{Binding ElementName=EditorTextBox}" ToolTip="切り取り (Ctrl+X)"
                    AutomationProperties.Name="切り取り" Padding="8,4">
                <TextBlock Text="✂" FontSize="16" />
            </Button>
            <Button Command="Copy" CommandTarget="{Binding ElementName=EditorTextBox}" ToolTip="コピー (Ctrl+C)"
                    AutomationProperties.Name="コピー" Padding="8,4">
                <TextBlock Text="📋" FontSize="16" />
            </Button>
            <Button Command="Paste" CommandTarget="{Binding ElementName=EditorTextBox}" ToolTip="貼り付け (Ctrl+V)"
                    AutomationProperties.Name="貼り付け" Padding="8,4">
                <TextBlock Text="📎" FontSize="16" />
            </Button>
            <Separator />
            <Button Command="{Binding HeadingCommand}" CommandParameter="1" ToolTip="見出し1"
                    AutomationProperties.Name="見出し1" Padding="8,4">
                <TextBlock Text="H1" FontWeight="SemiBold" FontSize="13" />
            </Button>
            <Button Command="{Binding HeadingCommand}" CommandParameter="2" ToolTip="見出し2"
                    AutomationProperties.Name="見出し2" Padding="8,4">
                <TextBlock Text="H2" FontWeight="SemiBold" FontSize="13" />
            </Button>
            <Button Command="{Binding BoldCommand}" ToolTip="太字 (Ctrl+B)" AutomationProperties.Name="太字" Padding="8,4">
                <TextBlock Text="B" FontWeight="Bold" FontSize="14" />
            </Button>
            <Button Command="{Binding ItalicCommand}" ToolTip="斜体 (Ctrl+I)" AutomationProperties.Name="斜体" Padding="8,4">
                <TextBlock Text="I" FontStyle="Italic" FontSize="14" />
            </Button>
            <Button Command="{Binding InlineCodeCommand}" ToolTip="インラインコード" AutomationProperties.Name="インラインコード" Padding="8,4">
                <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="12" />
            </Button>
            <Separator />
            <Button Command="{Binding BulletListCommand}" ToolTip="箇条書き" AutomationProperties.Name="箇条書き" Padding="8,4">
                <TextBlock Text="•—" FontSize="14" />
            </Button>
            <Button Command="{Binding OrderedListCommand}" ToolTip="番号付きリスト" AutomationProperties.Name="番号付きリスト" Padding="8,4">
                <TextBlock Text="1." FontSize="13" />
            </Button>
            <Button Command="{Binding QuoteCommand}" ToolTip="引用" AutomationProperties.Name="引用" Padding="8,4">
                <TextBlock Text="❝" FontSize="15" />
            </Button>
            <Separator />
            <Button Command="{Binding InsertImageCommand}" ToolTip="画像を挿入" AutomationProperties.Name="画像を挿入" Padding="8,4">
                <TextBlock Text="🖼" FontSize="16" />
            </Button>
            <Button Command="{Binding InsertLinkCommand}" ToolTip="リンクを挿入 (Ctrl+K)" AutomationProperties.Name="リンクを挿入" Padding="8,4">
                <TextBlock Text="🔗" FontSize="16" />
            </Button>
            <Separator />
            <ToggleButton IsChecked="{Binding IsPreviewVisible}" ToolTip="プレビューを表示/非表示"
                          AutomationProperties.Name="プレビューの表示切り替え" Padding="8,4">
                <TextBlock Text="👁" FontSize="16" />
            </ToggleButton>
        </ToolBar>

        <!-- Surfaces WebView2 problems instead of leaving a silently blank pane. -->
        <Border Grid.Row="2" Background="#FFF4CE" BorderBrush="#E8C36B" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding PreviewError}" TextWrapping="Wrap" Foreground="#5C4200" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" x:Name="EditorColumn" />
                <ColumnDefinition Width="Auto" x:Name="SplitterColumn" />
                <ColumnDefinition Width="*" x:Name="PreviewColumn" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F0F0" Padding="8,4">
                        <TextBlock Text="エディター" FontWeight="SemiBold" Foreground="#333" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0"
                                Visibility="{Binding ShowLineNumbers, Converter={StaticResource BoolToVisibilityConverter}}">
                            <controls:LineNumberMargin x:Name="LineNumbers"
                                                       Editor="{Binding ElementName=EditorTextBox}"
                                                       Foreground="#9A9A9A"
                                                       CurrentLineBrush="#2A6FD6" />
                        </Border>

                        <TextBox x:Name="EditorTextBox"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 AllowDrop="True"
                                 TextWrapping="{Binding WordWrap, Converter={StaticResource BoolToWrapConverter}}"
                                 FontFamily="Consolas, Meiryo"
                                 FontSize="{Binding EditorFontSize}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="6,2,8,8"
                                 BorderThickness="0"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 UndoLimit="200"
                                 AutomationProperties.Name="マークダウンエディター"
                                 Text="{Binding MarkdownText, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionChanged="EditorTextBox_SelectionChanged"
                                 PreviewKeyDown="EditorTextBox_PreviewKeyDown"
                                 PreviewMouseWheel="EditorTextBox_PreviewMouseWheel"
                                 PreviewDragOver="EditorTextBox_PreviewDragOver"
                                 Drop="EditorTextBox_Drop" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0"
                          AutomationProperties.Name="エディターとプレビューの境界"
                          Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Border Grid.Column="2"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Margin="4"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F0F0" Padding="8,4">
                        <TextBlock Text="プレビュー" FontWeight="SemiBold" Foreground="#333" />
                    </Border>
                    <wv2:WebView2 x:Name="PreviewWebView" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="4" Background="#F5F5F5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="行: " /><Run Text="{Binding CurrentLine, Mode=OneWay}" />
                    <Run Text=" 列: " /><Run Text="{Binding CurrentColumn, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding SelectionText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="文字数: " /><Run Text="{Binding CharacterCount, Mode=OneWay}" />
                    <Run Text=" 単語数: " /><Run Text="{Binding WordCount, Mode=OneWay}" />
                    <Run Text=" 行数: " /><Run Text="{Binding LineCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding EncodingStatus}" ToolTip="文字コード / 改行コード" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
