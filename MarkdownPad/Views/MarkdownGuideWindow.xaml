<Window x:Class="MarkdownPad.Views.MarkdownGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マークダウンガイド"
        Height="560"
        Width="520"
        MinHeight="300"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#555"
                   Text="記法の一覧です。編集中の内容は変更されません。必要な部分を選択してコピーするか、下のボタンでカーソル位置に挿入してください。" />

        <TextBox Grid.Row="1"
                 x:Name="GuideTextBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontFamily="Consolas, Meiryo"
                 FontSize="13"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="マークダウン記法の一覧" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="カーソル位置に挿入" Padding="12,4" Margin="0,0,8,0" Click="InsertButton_Click" />
            <Button Content="閉じる" Width="84" IsCancel="True" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
